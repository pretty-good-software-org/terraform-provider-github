#!/usr/bin/env bash
#MISE description="Check Markdown formatting with mdformat"
#MISE depends=["setup:mdformat"]
set -euo pipefail

# Recompute the content-addressed path instead of trusting an inherited export.
source "${MISE_PROJECT_ROOT:?MISE_PROJECT_ROOT must be set by mise}/mise-tasks/setup/mdformat-env"

# Provider docs are generated by tfplugindocs and retain their established
# formatting. Only repository-owned Markdown is checked here.
markdown_files=()
while IFS= read -r markdown_file; do
  markdown_files+=("$markdown_file")
done < <(find . -type f -name '*.md' -not -path './docs/*' -not -path './.git/*' -print)
((${#markdown_files[@]} > 0)) || exit 0
mdformat --check "${markdown_files[@]}"
